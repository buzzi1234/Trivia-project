<Window x:Class="Client_Server_Trivia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.cc:\users\cyber_user\documents\magshimim\trivia\triv\trivia-project\client server trivia\mainwindow.xaml.cs
c:\users\cyber_user\documents\magshimim\trivia\triv\trivia-project\client server trivia\mainwindow.xaml
om/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Client_Server_Trivia"
        mc:Ignorable="d"
        Title="Trivia Game - Login" 
        Height="800" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">

    <Window.Resources>
        <!-- Color Resources -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#ff6b6b"/>
        <SolidColorBrush x:Key="AccentColor" Color="#ee5a24"/>
        <SolidColorBrush x:Key="TextColor" Color="#2D3748"/>
        <SolidColorBrush x:Key="SubtextColor" Color="#4A5568"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E6ED"/>

        <!-- Gradient Brushes -->
        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#ff9a9e" Offset="0"/>
            <GradientStop Color="#fecfef" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F8F9FA" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#ff6b6b" Offset="0"/>
            <GradientStop Color="#ee5a24" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonHoverGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#ff5252" Offset="0"/>
            <GradientStop Color="#d63031" Offset="1"/>
        </LinearGradientBrush>

        <!-- Button Styles -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="25" 
                                BorderThickness="0">
                            <Border.Effect>
                                <DropShadowEffect Color="#ff6b6b" 
                                                BlurRadius="20" 
                                                ShadowDepth="0" 
                                                Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ButtonHoverGradient}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Input Field Styles -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Animations -->
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                           From="0" To="1" Duration="0:0:0.8"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" 
                           From="30" To="0" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInAnimation}"/>
        </EventTrigger>
    </Window.Triggers>

    <Grid Background="{StaticResource BackgroundGradient}">
        <Grid.RenderTransform>
            <TranslateTransform/>
        </Grid.RenderTransform>

        <!-- Close Button -->
        <Button Name="CloseButton" 
                Style="{StaticResource CloseButton}"
                Content="✕" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Margin="15,15,15,0"
                Click="CloseButton_Click"/>

        <!-- Decorative Background Elements -->
        <Ellipse Width="300" Height="300" 
                 HorizontalAlignment="Left" 
                 VerticalAlignment="Top" 
                 Margin="-150,-150,0,0" 
                 Fill="#FFFFFF" 
                 Opacity="0.1"/>

        <Ellipse Width="200" Height="200" 
                 HorizontalAlignment="Right" 
                 VerticalAlignment="Bottom" 
                 Margin="0,0,-100,-100" 
                 Fill="#FFFFFF" 
                 Opacity="0.1"/>

        <Ellipse Width="150" Height="150" 
                 HorizontalAlignment="Right" 
                 VerticalAlignment="Top" 
                 Margin="0,-75,-75,0" 
                 Fill="#FFFFFF" 
                 Opacity="0.08"/>

        <!-- Main Card -->
        <Border Background="{StaticResource CardGradient}" 
                CornerRadius="20" 
                Width="450" 
                Height="640" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" 
                                BlurRadius="30" 
                                ShadowDepth="10" 
                                Opacity="0.2"/>
            </Border.Effect>

            <StackPanel Margin="50,40">
                <!-- Logo Section -->
                <StackPanel Margin="0,0,0,30" HorizontalAlignment="Center">
                    <Viewbox Width="80" Height="80" Margin="0,0,0,20">
                        <Canvas Width="120" Height="120">
                            <!-- Background Circle -->
                            <Ellipse Width="120" Height="120" Fill="#ff6b6b" Opacity="0.1"/>
                            <!-- Left Book -->
                            <Rectangle Width="35" Height="50" Canvas.Left="25" Canvas.Top="35" 
                                     Fill="#667eea" RadiusX="5" RadiusY="5" 
                                     Stroke="White" StrokeThickness="2"/>
                            <Rectangle Width="25" Height="15" Canvas.Left="30" Canvas.Top="45" 
                                     Fill="White" RadiusX="2" RadiusY="2"/>
                            <Rectangle Width="25" Height="8" Canvas.Left="30" Canvas.Top="55" 
                                     Fill="White" RadiusX="2" RadiusY="2"/>
                            <!-- Right Book -->
                            <Rectangle Width="35" Height="50" Canvas.Left="60" Canvas.Top="35" 
                                     Fill="White" RadiusX="5" RadiusY="5" 
                                     Stroke="#ff6b6b" StrokeThickness="2"/>
                            <Path Canvas.Left="72" Canvas.Top="50" Fill="#ff6b6b" 
                                  Data="M0,5 C0,2 2,0 5,0 C8,0 10,2 10,5 C10,8 5,15 5,15 S0,8 0,5 Z"/>
                            <TextBlock Canvas.Left="63" Canvas.Top="37" Text="A" FontSize="8" 
                                     FontWeight="Bold" Foreground="#ff6b6b"/>
                            <!-- Stars -->
                            <Path Fill="#ffd700" Canvas.Left="15" Canvas.Top="20" 
                                  Data="M5,0 L6,3 L10,3 L7,5 L8,9 L5,7 L2,9 L3,5 L0,3 L4,3 Z"/>
                            <Path Fill="#ffd700" Canvas.Left="95" Canvas.Top="25" 
                                  Data="M3,0 L4,2 L6,2 L4,3 L5,6 L3,4 L1,6 L2,3 L0,2 L2,2 Z"/>
                            <Path Fill="#ffd700" Canvas.Left="85" Canvas.Top="90" 
                                  Data="M4,0 L5,2 L8,2 L6,4 L7,7 L4,5 L1,7 L2,4 L0,2 L3,2 Z"/>
                        </Canvas>
                    </Viewbox>
                </StackPanel>

                <!-- Title Section -->
                <TextBlock Text="TRIVIA MASTER" 
                          FontSize="32" 
                          FontWeight="Bold" 
                          Foreground="{StaticResource TextColor}" 
                          HorizontalAlignment="Center" 
                          Margin="0,0,0,10"/>

                <TextBlock Text="Welcome Back!" 
                          FontSize="24" 
                          FontWeight="SemiBold" 
                          Foreground="{StaticResource SubtextColor}" 
                          HorizontalAlignment="Center" 
                          Margin="0,0,0,8"/>

                <TextBlock Text="Login to start your trivia adventure" 
                          FontSize="14" 
                          Foreground="#718096" 
                          HorizontalAlignment="Center" 
                          Margin="0,0,0,30"/>

                <!-- Input Fields Section -->
                <StackPanel Margin="0,0,0,25">
                    <!-- Username Field -->
                    <TextBlock Text="Username" 
                              FontSize="14" 
                              FontWeight="SemiBold" 
                              Foreground="{StaticResource SubtextColor}" 
                              Margin="0,0,0,8"/>
                    <TextBox x:Name="UsernameTextBox" 
                            Style="{StaticResource ModernTextBox}" 
                            Height="45" 
                            TextChanged="UsernameTextBox_TextChanged"/>

                    <!-- Password Field -->
                    <TextBlock Text="Password" 
                              FontSize="14" 
                              FontWeight="SemiBold" 
                              Foreground="{StaticResource SubtextColor}" 
                              Margin="0,20,0,8"/>
                    <Grid>
                        <PasswordBox x:Name="PasswordBox" 
                                    Style="{StaticResource ModernPasswordBox}" 
                                    Height="45"/>
                        <TextBox x:Name="PasswordTextBox"
                                Style="{StaticResource ModernTextBox}"
                                Height="45"
                                Visibility="Hidden"/>
                    </Grid>
                </StackPanel>

                <!-- Buttons Section -->
                <Button Name="LoginButton" 
                       Content="Login" 
                       Style="{StaticResource ModernButton}" 
                       Height="50" 
                       Margin="0,0,0,20" 
                       Click="LoginButton_Click"/>

                <Button Name="SignupButton" 
                       Content="Don't have an account? Sign up here" 
                       Style="{StaticResource LinkButton}"
                       Click="SignupButton_Click"/>

                <!-- Error Message -->
                <TextBlock Name="ErrorMessageTextBlock" 
                          Text="" 
                          Foreground="#E53E3E" 
                          FontSize="12" 
                          HorizontalAlignment="Center" 
                          Margin="0,15,0,0" 
                          Visibility="Collapsed"
                          TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>