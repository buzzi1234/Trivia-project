<Window x:Class="Client_Server_Trivia.SignupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Trivia Game - Sign Up"
        Height="820" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">

    <Window.Resources>
        <!-- גרדיאנט רקע -->
        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#ff9a9e" Offset="0"/>
            <GradientStop Color="#fecfef" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F8F9FA" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="PrimaryColor" Color="#ff6b6b"/>
        <SolidColorBrush x:Key="AccentColor" Color="#ee5a24"/>


        <!-- כפתור מודרני -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#ff6b6b" Offset="0"/>
                        <GradientStop Color="#ee5a24" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="25">
                            <Border.Effect>
                                <DropShadowEffect Color="#ff6b6b" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#ff5252" Offset="0"/>
                                            <GradientStop Color="#d63031" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- טקסטבוקס -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E6ED"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#ff6b6b"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E6ED"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#ff6b6b"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- אנימציית פתיחה -->
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:1"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="50" To="0" Duration="0:0:1">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInAnimation}"/>
        </EventTrigger>
    </Window.Triggers>


    <Grid Background="{StaticResource BackgroundGradient}" Margin="0,72,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="50*"/>
            <ColumnDefinition Width="247*"/>
            <ColumnDefinition Width="303*"/>
        </Grid.ColumnDefinitions>
        <Grid.RenderTransform>
            <TranslateTransform/>
        </Grid.RenderTransform>

        <Button Name="CloseButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,15,0" Width="30" Height="30" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="16" Content="✕" Cursor="Hand" Click="CloseButton_Click" Grid.Column="3"/>

        <!-- טופס מרכזי -->
        <Border Background="{StaticResource CardGradient}" CornerRadius="20" Width="500" Height="570" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="2" Grid.ColumnSpan="2">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="10" Opacity="0.2"/>
            </Border.Effect>

            <StackPanel Margin="50,30">
                <TextBlock Text="Create Account" FontSize="32" FontWeight="Bold" Foreground="#2D3748" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <!-- שדות -->
                <TextBlock Text="Username" FontSize="14" Margin="0,0,0,5"/>
                <TextBox Name="UsernameTextBox" Style="{StaticResource ModernTextBox}" Height="45" FontFamily="Rockwell"/>

                <TextBlock Text="Email" FontSize="14" Margin="0,15,0,5"/>
                <TextBox Name="EmailTextBox" Style="{StaticResource ModernTextBox}" Height="45" FontFamily="Rockwell"/>

                <TextBlock Text="Password" FontSize="14" Margin="0,15,0,5"/>
                <PasswordBox Name="PasswordBox" Style="{StaticResource ModernPasswordBox}" Height="45"/>

                <TextBlock Text="Confirm Password" FontSize="14" Margin="0,15,0,5"/>
                <PasswordBox Name="ConfirmPasswordBox" Style="{StaticResource ModernPasswordBox}" Height="45"/>

                <!-- כפתורים -->
                <Button Name="SignupButton" Content="Sign Up" Style="{StaticResource ModernButton}" Height="50" Margin="0,30,0,10" Click="SignupButton_Click"/>
                <Button Name="LoginButton" Content="Back to Login" Background="Transparent" Foreground="{StaticResource PrimaryColor}" BorderThickness="0" FontSize="14" Click="LoginButton_Click"/>

                <!-- הודעת שגיאה -->
                <TextBlock Name="ErrorMessageTextBlock" Text="" Foreground="#E53E3E" FontSize="12" HorizontalAlignment="Center" Margin="0,15,0,0" Visibility="Collapsed"/>


            </StackPanel>
        </Border>
    </Grid>
</Window>
