<Window x:Class="Client_Server_Trivia.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Client_Server_Trivia"
        mc:Ignorable="d"
        Title="Trivia Game - Statistics"
        Height="745" Width="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">
    <Window.Resources>
        <!-- Gradients and Colors -->
        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#ff9a9e" Offset="0"/>
            <GradientStop Color="#fecfef" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F8F9FA" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PersonalStatsGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4CAF50" Offset="0"/>
            <GradientStop Color="#45a049" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LeaderboardGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF9800" Offset="0"/>
            <GradientStop Color="#F57C00" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PrimaryColor" Color="#ff6b6b"/>
        <SolidColorBrush x:Key="AccentColor" Color="#ee5a24"/>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#ff6b6b" Offset="0"/>
                        <GradientStop Color="#ee5a24" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="25">
                            <Border.Effect>
                                <DropShadowEffect Color="#ff6b6b" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#ff5252" Offset="0"/>
                                            <GradientStop Color="#d63031" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Personal Stats Button Style -->
        <Style x:Key="PersonalStatsButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PersonalStatsGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="30,20"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                            <Border.Effect>
                                <DropShadowEffect Color="#4CAF50" BlurRadius="25" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#43A047" Offset="0"/>
                                            <GradientStop Color="#388E3C" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Leaderboard Button Style -->
        <Style x:Key="LeaderboardButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource LeaderboardGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="30,20"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF9800" BlurRadius="25" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FB8C00" Offset="0"/>
                                            <GradientStop Color="#EF6C00" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Statistics Card Style -->
        <Style x:Key="StatisticsCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Margin" Value="15"/>
            <Setter Property="Padding" Value="30"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="25" ShadowDepth="8" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fade In Animation -->
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.8"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="30" To="0" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInAnimation}"/>
        </EventTrigger>
    </Window.Triggers>

    <Grid Background="{StaticResource BackgroundGradient}">
        <Grid.RenderTransform>
            <TranslateTransform/>
        </Grid.RenderTransform>

        <!-- Close Button -->
        <Button Name="CloseButton" HorizontalAlignment="Right" VerticalAlignment="Top" 
                Margin="0,20,20,0" Width="35" Height="35" 
                Background="Transparent" BorderThickness="0" 
                Foreground="White" FontSize="18" Content="✕" 
                Cursor="Hand" Click="CloseButton_Click"/>

        <!-- Background Decorative Elements -->
        <Ellipse Width="300" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top" 
                 Margin="-150,-150,0,0" Fill="#FFFFFF" Opacity="0.1"/>
        <Ellipse Width="200" Height="200" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                 Margin="0,0,-100,-100" Fill="#FFFFFF" Opacity="0.1"/>
        <Ellipse Width="150" Height="150" HorizontalAlignment="Right" VerticalAlignment="Top" 
                 Margin="0,-75,-50,0" Fill="#FFFFFF" Opacity="0.1"/>

        <!-- Main Card -->
        <Border Background="{StaticResource CardGradient}" CornerRadius="25" 
                MaxWidth="700" MaxHeight="650" 
                HorizontalAlignment="Center" VerticalAlignment="Center" Height="690">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="15" Opacity="0.3"/>
            </Border.Effect>

            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Section -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <!-- Logo -->
                    <Viewbox Width="70" Height="70" Margin="0,0,0,15">
                        <Canvas Width="120" Height="120">
                            <Ellipse Width="120" Height="120" Fill="#ff6b6b" Opacity="0.1"/>
                            <Rectangle Width="35" Height="50" Canvas.Left="25" Canvas.Top="35" 
                                     Fill="#667eea" RadiusX="5" RadiusY="5" Stroke="White" StrokeThickness="2"/>
                            <Rectangle Width="25" Height="15" Canvas.Left="30" Canvas.Top="45" 
                                     Fill="White" RadiusX="2" RadiusY="2"/>
                            <Rectangle Width="25" Height="8" Canvas.Left="30" Canvas.Top="55" 
                                     Fill="White" RadiusX="2" RadiusY="2"/>
                            <Rectangle Width="35" Height="50" Canvas.Left="60" Canvas.Top="35" 
                                     Fill="White" RadiusX="5" RadiusY="5" Stroke="#ff6b6b" StrokeThickness="2"/>
                            <Path Canvas.Left="72" Canvas.Top="50" Fill="#ff6b6b" 
                                  Data="M0,5 C0,2 2,0 5,0 C8,0 10,2 10,5 C10,8 5,15 5,15 S0,8 0,5 Z"/>
                            <TextBlock Canvas.Left="63" Canvas.Top="37" Text="A" FontSize="8" 
                                     FontWeight="Bold" Foreground="#ff6b6b"/>
                            <Path Fill="#ffd700" Canvas.Left="15" Canvas.Top="20" 
                                  Data="M5,0 L6,3 L10,3 L7,5 L8,9 L5,7 L2,9 L3,5 L0,3 L4,3 Z"/>
                            <Path Fill="#ffd700" Canvas.Left="95" Canvas.Top="25" 
                                  Data="M3,0 L4,2 L6,2 L4,3 L5,6 L3,4 L1,6 L2,3 L0,2 L2,2 Z"/>
                            <Path Fill="#ffd700" Canvas.Left="85" Canvas.Top="90" 
                                  Data="M4,0 L5,2 L8,2 L6,4 L7,7 L4,5 L1,7 L2,4 L0,2 L3,2 Z"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="TRIVIA MASTER" FontSize="32" FontWeight="Bold" 
                              Foreground="#2D3748" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="Statistics" FontSize="20" FontWeight="SemiBold" 
                              Foreground="#4A5568" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Subtitle -->
                <TextBlock Grid.Row="1" Text="View your performance and compete with others!" 
                          FontSize="14" Foreground="#718096" HorizontalAlignment="Center" 
                          Margin="0,0,0,30"/>

                <!-- Statistics Options -->
                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Personal Statistics Card -->
                    <Border Grid.Row="0" Style="{StaticResource StatisticsCard}" Margin="15,-15,15,15">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="View your games played, win rate, average score and personal achievements" 
                                      FontSize="12" Foreground="#718096" HorizontalAlignment="Center" 
                                      TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"/>
                            <Button Name="PersonalStatsButton" Content="View My Stats" 
                                   Style="{StaticResource PersonalStatsButton}" 
                                   Click="PersonalStatsButton_Click" Height="35"/>
                        </StackPanel>
                    </Border>

                    <!-- Leaderboard Card -->
                    <Border Style="{StaticResource StatisticsCard}" Margin="15,119,15,28" Grid.RowSpan="3">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="See who's leading the competition and compare your ranking with other players" 
                                      FontSize="12" Foreground="#718096" HorizontalAlignment="Center" 
                                      TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"/>
                            <Button Name="LeaderboardButton" Content="View Rankings" 
                                   Style="{StaticResource LeaderboardButton}" 
                                   Click="LeaderboardButton_Click" Height="39"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Back Button -->
                <Button Grid.Row="3" Name="BackButton" Content="Back to Menu" 
                       Style="{StaticResource ModernButton}" Height="45" Width="180" 
                       HorizontalAlignment="Center" Click="BackButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>